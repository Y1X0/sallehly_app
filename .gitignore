# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# pubspec.lock is committed intentionally (this is an application, not a
# library) to pin exact dependency versions for reproducible CI/release
# builds. A loose Dio version range once let CI silently re-resolve to a
# newer Dio patch with a different DioExceptionType enum and break the build.

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# [FIX-L10N-01] مولَّدة تلقائياً من lib/l10n/*.arb عبر `flutter gen-l10n`
# (يُشغَّل ضمن `flutter pub get`، راجع l10n.yaml) — لا تُعدَّل يدوياً ولا تُضاف
# للـgit؛ أي بيئة تبني المشروع تُعيد توليدها بنفسها من ملفات ARB المصدر.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

ios/Runner/GoogleService-Info.plist
